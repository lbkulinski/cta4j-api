###
GET http://localhost:8080/api/bus/routes

###
@routeId = 22
GET http://localhost:8080/api/bus/routes/{{routeId}}/directions

###
@direction = Southbound
GET http://localhost:8080/api/bus/routes/{{routeId}}/directions/{{direction}}/stops

###
@stopId = 1828
GET http://localhost:8080/api/bus/stops/{{stopId}}

###
GET http://localhost:8080/api/bus/stops/{{stopId}}/arrivals

###
GET http://localhost:8080/api/bus/detours

###
@busId = 4325
GET http://localhost:8080/api/buses/{{busId}}

###
GET http://localhost:8080/api/stations

###
@stationId = 41320
GET http://localhost:8080/api/stations/{{stationId}}/arrivals

###
@run = 409
GET http://localhost:8080/api/trains/{{run}}
